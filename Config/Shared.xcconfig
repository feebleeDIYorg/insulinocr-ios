APPLE_TEAM_ID = SIMULATOR1
INSULINOCR_APP_IDENTIFIER = org.example.insulinocr
INSULINOCR_APP_GROUP = group.org.example.insulinocr
INSULINOCR_CLOUDKIT_CONTAINER = iCloud.org.example.insulinocr
#include? "Local.generated.xcconfig"
DEVELOPMENT_TEAM = $(APPLE_TEAM_ID)
IPHONEOS_DEPLOYMENT_TARGET = 18.0
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_UPCOMING_FEATURE_EXISTENTIAL_ANY = YES
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
VERSIONING_SYSTEM = apple-generic
ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
ENABLE_MODULE_VERIFIER = YES
OTHER_SWIFT_FLAGS = $(inherited) -warnings-as-errors
