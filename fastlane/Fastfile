require "base64"
require_relative "lib/insulinocr_credentials"
require_relative "lib/insulinocr_build_configuration"
require_relative "lib/insulinocr_delivery_status"
require_relative "lib/insulinocr_setup_policy"

default_platform(:ios)

# Fastlane evaluates lane blocks in fastlane/, while individual actions may
# change directories. Resolve paths once so shell helpers and actions agree.
PROJECT_ROOT = File.expand_path("..", FastlaneCore::FastlaneFolder.path)
PROJECT = File.join(PROJECT_ROOT, "InsulinOCR.xcodeproj")
SCHEME = "InsulinOCR"
def configured_app_identifier
  ENV.fetch("APP_IDENTIFIER")
end

def configured_app_identifiers
  [configured_app_identifier, "#{configured_app_identifier}.share"]
end

def prepare_delivery_configuration
  InsulinOCRDeliveryStatus.around("configuration") { InsulinOCRBuildConfiguration.prepare(PROJECT_ROOT, signing: true) }
end

def prepare_signing
  prepare_delivery_configuration
  InsulinOCRDeliveryStatus.around("project_generation") { generate_project }
end
def require_internal_delivery_authorization
  event = JSON.parse(File.read(ENV.fetch("GITHUB_EVENT_PATH")))
  UI.user_error!("Verified main CI and an explicitly selected internal delivery are required") unless
    InsulinOCRSetupPolicy.delivery_authorized?(ENV, event)
end

def app_store_connect_key
  options = begin
    InsulinOCRCredentials.apple_api_key_options(ENV)
  rescue ArgumentError => error
    UI.user_error!(error.message)
  end
  app_store_connect_api_key(**options)
end

def generate_project
  ENV["APPLE_TEAM_ID"] ||= ENV.fetch("TEAMID", "SIMULATOR1")
  sh("xcodegen", "generate", "--spec", File.join(PROJECT_ROOT, "project.yml"))
end

def read_only_signing_preflight
  ensure_env_vars(env_vars: %w[MATCH_PASSWORD])
  key = InsulinOCRDeliveryStatus.around("apple_key") { app_store_connect_key }
  InsulinOCRDeliveryStatus.around("keychain") { setup_ci } if ENV["CI"] == "true"
  InsulinOCRDeliveryStatus.around("match") do
    sync_code_signing(
      type: "appstore",
      app_identifier: configured_app_identifiers,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      api_key: key,
      git_url: ENV.fetch("MATCH_GIT_URL"),
      git_branch: ENV.fetch("MATCH_GIT_BRANCH"),
      certificate_id: ENV["INSULINOCR_EXISTING_CERTIFICATE_ID"],
      readonly: true
    )
  end
  key
end

platform :ios do
  desc "1. Validate existing credentials and encrypted certificate without requiring app profiles"
  lane :validate_secrets do
    prepare_delivery_configuration
    key = InsulinOCRDeliveryStatus.around("apple_key") { app_store_connect_key }
    InsulinOCRDeliveryStatus.around("keychain") { setup_ci } if ENV["CI"] == "true"
    InsulinOCRDeliveryStatus.around("apple_access") do
      certificate = Spaceship::ConnectAPI::Certificate.get(certificate_id: ENV.fetch("INSULINOCR_EXISTING_CERTIFICATE_ID"))
      UI.user_error!("Existing distribution certificate is unavailable") unless certificate &&
        %w[DISTRIBUTION IOS_DISTRIBUTION].include?(certificate.certificate_type) && Time.parse(certificate.expiration_date) > Time.now
    end
    InsulinOCRDeliveryStatus.around("match") do
      sync_code_signing(type: "appstore", app_identifier: [], skip_provisioning_profiles: true,
        team_id: ENV.fetch("APPLE_TEAM_ID"), api_key: key, git_url: ENV.fetch("MATCH_GIT_URL"),
        git_branch: ENV.fetch("MATCH_GIT_BRANCH"), certificate_id: ENV.fetch("INSULINOCR_EXISTING_CERTIFICATE_ID"), readonly: true)
    end
  end

  desc "2. Add missing app identifiers and capabilities without removing existing capabilities"
  lane :identifiers do
    validate_secrets
    InsulinOCRDeliveryStatus.around("identifiers") do
      [[configured_app_identifier, "InsulinOCR", %w[APP_GROUPS ICLOUD PUSH_NOTIFICATIONS DATA_PROTECTION]],
       ["#{configured_app_identifier}.share", "InsulinOCR Share", %w[APP_GROUPS DATA_PROTECTION]]].each do |identifier, name, capabilities|
        # Apple's identifier filter is a prefix search; require exact identity.
        matches = Spaceship::ConnectAPI::BundleId.all(filter: {identifier: identifier}).select { |bundle| bundle.identifier == identifier }
        UI.user_error!("Ambiguous registered app identifier") if matches.length > 1
        bundle = matches.first || Spaceship::ConnectAPI::BundleId.create(name: name, identifier: identifier, platform: "IOS")
        existing = bundle.get_capabilities.map(&:capability_type)
        (capabilities - existing).each { |capability| bundle.create_capability(capability) }
      end
    end
  end

  desc "3. Check existing app profiles without generating an Xcode project"
  lane :check_profiles do
    prepare_delivery_configuration
    read_only_signing_preflight
  end

  desc "3. Prepare only app profiles using the existing encrypted distribution identity"
  lane :prepare_profiles do
    event = JSON.parse(File.read(ENV.fetch("GITHUB_EVENT_PATH")))
    UI.user_error!("Explicit protected profile setup is required") unless InsulinOCRSetupPolicy.profile_creation_authorized?(ENV, event)
    validate_secrets
    # Block Match's certificate generation path, including expiry races.
    Match::Generator.singleton_class.prepend(InsulinOCRSetupPolicy::ExistingCertificateOnly)
    key = app_store_connect_key
    InsulinOCRDeliveryStatus.around("profiles") do
      sync_code_signing(type: "appstore", app_identifier: configured_app_identifiers,
        team_id: ENV.fetch("APPLE_TEAM_ID"), api_key: key, git_url: ENV.fetch("MATCH_GIT_URL"),
        git_branch: ENV.fetch("MATCH_GIT_BRANCH"), certificate_id: ENV.fetch("INSULINOCR_EXISTING_CERTIFICATE_ID"),
        readonly: false, force: false, verbose: false)
    end
  end

  desc "Generate the project and execute core, integration, and UI tests on Simulator"
  lane :test do
    InsulinOCRBuildConfiguration.prepare(PROJECT_ROOT, signing: false)
    generate_project
    sh("swift", "test", "--package-path", File.join(PROJECT_ROOT, "Packages/InsulinOCRCore"))
    sh("python3", "-m", "unittest", "discover", "-s", File.join(PROJECT_ROOT, "Scripts"), "-p", "test_*.py", "-v")
    helper = File.join(PROJECT_ROOT, "Scripts/prepare_ui_test_host.py")
    arguments = ["python3", helper, "--device", ENV.fetch("SIMULATOR_DEVICE", "iPhone 17 Pro")]
    arguments += ["--os", ENV.fetch("SIMULATOR_OS")] if ENV["SIMULATOR_OS"]
    arguments += ["--udid", ENV.fetch("SIMULATOR_UDID")] if ENV["SIMULATOR_UDID"]
    preparation = sh(*arguments)
    simulator_id = preparation.lines.grep(/\ASIMULATOR_UDID=/).last&.split("=", 2)&.last&.strip
    UI.user_error!("The screenshot share host did not report its simulator") unless simulator_id&.match?(/\A[0-9A-Fa-f-]{36}\z/)

    scan(
      project: PROJECT,
      scheme: SCHEME,
      clean: true,
      destination: "platform=iOS Simulator,id=#{simulator_id}",
      parallel_testing: false,
      code_coverage: true,
      derived_data_path: File.join(PROJECT_ROOT, "build/DerivedData"),
      output_directory: File.join(PROJECT_ROOT, "build/test_output"),
      result_bundle: true,
      xcargs: "CODE_SIGN_IDENTITY=- CODE_SIGNING_ALLOWED=YES CODE_SIGN_STYLE=Manual PROVISIONING_PROFILE_SPECIFIER="
    )
    sh("python3", File.join(PROJECT_ROOT, "Scripts/verify_ui_archive.py"), "--udid", simulator_id)
  end

  desc "Create or renew development and App Store profiles in the encrypted Match repository"
  lane :setup_signing do
    UI.user_error!("setup_signing may not run in CI") if ENV["CI"] == "true"
    ensure_env_vars(env_vars: %w[MATCH_PASSWORD])

    prepare_signing
    key = app_store_connect_key
    %w[development appstore].each do |profile_type|
      sync_code_signing(
        type: profile_type,
        app_identifier: configured_app_identifiers,
        api_key: key,
        team_id: ENV.fetch("APPLE_TEAM_ID"),
        git_url: ENV.fetch("MATCH_GIT_URL"),
        git_branch: ENV.fetch("MATCH_GIT_BRANCH"),
        readonly: false
      )
    end
  end

  desc "Verify existing signing access and encrypted profiles without uploading"
  lane :signing_preflight do
    prepare_signing
    read_only_signing_preflight
  end

  desc "Build and upload an internal TestFlight build"
  lane :beta do |options|
    require_internal_delivery_authorization if ENV["CI"] == "true"
    test unless options[:tests_completed] == true && ENV["CI"] == "true"
    prepare_signing
    key = read_only_signing_preflight

    profiles = InsulinOCRSetupPolicy.profile_mapping(configured_app_identifiers,
      Actions.lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING])
    configured_app_identifiers.zip(["InsulinOCR", "InsulinOCRShareExtension"]).each do |identifier, target|
      update_code_signing_settings(path: PROJECT, use_automatic_signing: false,
        team_id: ENV.fetch("APPLE_TEAM_ID"), profile_name: profiles.fetch(identifier),
        targets: [target], build_configurations: ["Release"])
    end

    next_build_number = InsulinOCRDeliveryStatus.around("app_store_build_number") do
      latest_testflight_build_number(
      api_key: key,
      app_identifier: configured_app_identifier,
      initial_build_number: 0
      ) + 1
    end

    increment_build_number(
      build_number: next_build_number,
      xcodeproj: PROJECT
    )

    InsulinOCRDeliveryStatus.around("archive") do
      build_app(
      project: PROJECT,
      scheme: SCHEME,
      clean: true,
      export_method: "app-store",
      output_directory: File.join(PROJECT_ROOT, "build"),
      output_name: "InsulinOCR.ipa",
      include_symbols: true,
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: ENV.fetch("APPLE_TEAM_ID"),
        provisioningProfiles: profiles
      }
      )
    end

    InsulinOCRDeliveryStatus.around("upload") do
      upload_to_testflight(
      api_key: key,
      app_identifier: configured_app_identifier,
      **InsulinOCRSetupPolicy.internal_distribution_options(ENV["INSULINOCR_DELIVERY_MODE"],
        options[:release_notes] || ENV.fetch("RELEASE_NOTES", "Interner InsulinOCR-Testbuild")),
      skip_waiting_for_build_processing: false
      )
    end
  end

  desc "Finish one existing internal QA build without signing, archiving or uploading"
  lane :distribute_existing_qa do
    UI.user_error!("Protected manual CI delivery is required") unless ENV["CI"] == "true" && ENV["INSULINOCR_DELIVERY_MODE"] == "qa_distribute"
    require_internal_delivery_authorization
    prepare_signing # Configuration and project generation only; no Match call.
    key = InsulinOCRDeliveryStatus.around("apple_key") { app_store_connect_key }
    version = get_version_number(xcodeproj: PROJECT, target: "InsulinOCR")
    InsulinOCRDeliveryStatus.around("distribution") do
      upload_to_testflight(api_key: key, app_identifier: configured_app_identifier,
        distribute_only: true, app_version: version,
        build_number: ENV.fetch("INSULINOCR_EXISTING_BUILD_NUMBER"),
        **InsulinOCRSetupPolicy.internal_distribution_options("qa_distribute",
          ENV.fetch("RELEASE_NOTES", "Interner InsulinOCR-Testbuild")),
        skip_waiting_for_build_processing: false)
    end
  end
end
